#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${FAKE_DOCKER_ROOT:?FAKE_DOCKER_ROOT is required}"
mkdir -p "$ROOT"

safe_name(){
  printf '%s' "$1" | sed 's/[^A-Za-z0-9._-]/_/g'
}

log_call(){
  printf '%s\t%s\n' "$(pwd)" "$*" >> "$ROOT/calls.log"
}

stack_id(){
  if [[ -f .fake-docker-id ]]; then
    cat .fake-docker-id
  else
    safe_name "$(pwd)"
  fi
}

image_file(){
  local image="$1" suffix="$2"
  printf '%s/images/%s.%s' "$ROOT" "$(safe_name "$image")" "$suffix"
}

image_id(){
  local image="$1" file
  file="$(image_file "$image" id)"
  [[ -f "$file" ]] && cat "$file"
}

image_digests(){
  local image="$1" file
  file="$(image_file "$image" digests)"
  [[ -f "$file" ]] && cat "$file"
}

image_label(){
  local image="$1" key="$2" file
  file="$(image_file "$image" labels)"
  [[ -f "$file" ]] || return 0
  awk -v key="$key" -F= '
    $1 == key {
      sub(/^[^=]*=/, "")
      print
      exit
    }' "$file"
}

manifest_file(){
  local image="$1" suffix="$2"
  printf '%s/manifests/%s.%s' "$ROOT" "$(safe_name "$image")" "$suffix"
}

compose_service_images_from_file(){
  local file="$1" service="${2:-}" output
  [[ -f "$file" ]] || return 1
  output="$(awk -v wanted="$service" '
    { sub(/\r$/, "") }
    /^  [A-Za-z0-9_.-]+:/ {
      svc = $1
      sub(/:$/, "", svc)
      next
    }
    /^[[:space:]]+image:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]*image:[[:space:]]*/, "", value)
      sub(/[[:space:]]+#.*/, "", value)
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      quote = substr(value, 1, 1)
      if ((quote == "\"" || quote == "\047") && substr(value, length(value), 1) == quote) {
        value = substr(value, 2, length(value) - 2)
      }
      if (value != "" && (wanted == "" || svc == wanted)) {
        print value
      }
    }
  ' "$file")"
  [[ -n "$output" ]] || return 1
  printf '%s\n' "$output"
}

compose_services_from_file(){
  local file="$1" output
  [[ -f "$file" ]] || return 1
  output="$(awk '
    { sub(/\r$/, "") }
    /^  [A-Za-z0-9_.-]+:/ {
      svc = $1
      sub(/:$/, "", svc)
      print svc
    }
  ' "$file")"
  [[ -n "$output" ]] || return 1
  printf '%s\n' "$output"
}

compose_config_json_from_file(){
  local file="$1" project_directory="${2:-}" output project_name
  [[ -f "$file" ]] || return 1
  output="$(awk '
    { sub(/\r$/, "") }
    function esc(value) {
      gsub(/\\/, "\\\\", value)
      gsub(/"/, "\\\"", value)
      return value
    }
    function scalar(value) {
      sub(/^[[:space:]]*-[[:space:]]*/, "", value)
      sub(/^[[:space:]]*[^:]+:[[:space:]]*/, "", value)
      sub(/[[:space:]]+#.*/, "", value)
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      quote = substr(value, 1, 1)
      if ((quote == "\"" || quote == "\047") && substr(value, length(value), 1) == quote) {
        value = substr(value, 2, length(value) - 2)
      }
      return value
    }
    function add_label(key, value) {
      if (key == "") {
        return
      }
      label_keys[++label_count] = key
      label_values[label_count] = value
    }
    function add_label_string(value) {
      key = value
      label_value = ""
      if (index(value, "=") > 0) {
        key = value
        sub(/=.*/, "", key)
        label_value = value
        sub(/^[^=]*=/, "", label_value)
      }
      add_label(key, label_value)
    }
    function flush_service() {
      if (svc != "" && image != "") {
        if (found) {
          printf ","
        }
        printf "\"%s\":{\"image\":\"%s\"", esc(svc), esc(image)
        if (platform != "") {
          printf ",\"platform\":\"%s\"", esc(platform)
        }
        if (network_mode != "") {
          printf ",\"network_mode\":\"%s\"", esc(network_mode)
        }
        if (expose_count > 0) {
          printf ",\"expose\":["
          for (i = 1; i <= expose_count; i++) {
            if (i > 1) {
              printf ","
            }
            printf "\"%s\"", esc(expose[i])
          }
          printf "]"
        }
        if (label_count > 0) {
          printf ",\"labels\":{"
          for (i = 1; i <= label_count; i++) {
            if (i > 1) {
              printf ","
            }
            printf "\"%s\":\"%s\"", esc(label_keys[i]), esc(label_values[i])
          }
          printf "}"
        }
        printf "}"
        found = 1
      }
      expose_count = 0
      in_expose = 0
      label_count = 0
      in_labels = 0
    }
    /^  [A-Za-z0-9_.-]+:/ {
      flush_service()
      svc = $1
      sub(/:$/, "", svc)
      image = ""
      platform = ""
      network_mode = ""
      expose_count = 0
      in_expose = 0
      label_count = 0
      in_labels = 0
      next
    }
    /^[[:space:]]+expose:[[:space:]]*$/ {
      in_expose = 1
      in_labels = 0
      next
    }
    /^[[:space:]]+labels:[[:space:]]*$/ {
      in_expose = 0
      in_labels = 1
      next
    }
    /^[[:space:]]+-[[:space:]]*/ {
      if (in_expose) {
        expose[++expose_count] = scalar($0)
        next
      }
      if (in_labels) {
        add_label_string(scalar($0))
        next
      }
    }
    /^[[:space:]]+image:[[:space:]]*/ {
      in_expose = 0
      in_labels = 0
      image = scalar($0)
      next
    }
    /^[[:space:]]+platform:[[:space:]]*/ {
      in_expose = 0
      in_labels = 0
      platform = scalar($0)
      next
    }
    /^[[:space:]]+network_mode:[[:space:]]*/ {
      in_expose = 0
      in_labels = 0
      network_mode = scalar($0)
      next
    }
    /^      [A-Za-z0-9_.-]+:[[:space:]]*/ {
      if (in_labels) {
        label_key = $0
        sub(/^[[:space:]]+/, "", label_key)
        sub(/:.*/, "", label_key)
        add_label(label_key, scalar($0))
        next
      }
    }
    /^[[:space:]]+[A-Za-z0-9_.-]+:/ {
      in_expose = 0
      in_labels = 0
    }
    END {
      flush_service()
      if (!found) {
        exit 1
      }
    }
  ' "$file")" || return 1
  project_name="${COMPOSE_PROJECT_NAME:-}"
  if [[ -z "$project_name" ]]; then
    project_name="$(awk '
      /^name:[[:space:]]*/ {
        sub(/^name:[[:space:]]*/, "")
        gsub(/^["\047]|["\047]$/, "")
        print
        exit
      }
    ' "$file")"
  fi
  printf '{"name":"%s","services":{%s}}\n' "${project_name:-$(basename "${project_directory:-$PWD}")}" "$output"
}

service_images(){
  local id="$1" service="${2:-}" file="${3:-}"
  if [[ -n "$file" ]] && compose_service_images_from_file "$file" "$service"; then
    return 0
  elif [[ -n "$service" && -f "$ROOT/stacks/$id/service-images.tsv" ]]; then
    awk -v service="$service" 'BEGIN{FS="\t"} $1 == service {print $2}' "$ROOT/stacks/$id/service-images.tsv"
  elif [[ -f "$ROOT/stacks/$id/images.txt" ]]; then
    cat "$ROOT/stacks/$id/images.txt"
  fi
}

service_cids(){
  local id="$1" service="${2:-}" file
  if [[ -n "$service" ]]; then
    file="$ROOT/stacks/$id/cids-$service.txt"
    [[ -f "$file" ]] && cat "$file"
  else
    file="$ROOT/stacks/$id/cids.txt"
    [[ -f "$file" ]] && cat "$file"
  fi
  return 0
}

apply_image_after_pull(){
  local image="$1" safe src dst
  safe="$(safe_name "$image")"
  src="$ROOT/images/$safe.after_id"
  dst="$ROOT/images/$safe.id"
  if [[ -f "$src" ]]; then
    cp "$src" "$dst"
  fi
  src="$ROOT/images/$safe.after_digests"
  dst="$ROOT/images/$safe.digests"
  if [[ -f "$src" ]]; then
    cp "$src" "$dst"
  fi
}

apply_pull_state(){
  local id="$1" file="$2"
  shift 2 || true
  local services=() arg service image
  for arg in "$@"; do
    [[ "$arg" == -* ]] && continue
    services+=("$arg")
  done

  if ((${#services[@]})); then
    for service in "${services[@]}"; do
      while IFS= read -r image; do
        [[ -z "$image" ]] && continue
        apply_image_after_pull "$image"
      done < <(service_images "$id" "$service" "$file" || true)
    done
  else
    while IFS= read -r image; do
      [[ -z "$image" ]] && continue
      apply_image_after_pull "$image"
    done < <(service_images "$id" "" "$file" || true)
  fi
}

run_post_pull_hook(){
  local id="$1"
  shift || true
  if [[ -x "$ROOT/post-pull-hook" ]]; then
    "$ROOT/post-pull-hook" "$id" "$@"
  fi
}

run_post_up_hook(){
  local id="$1"
  shift || true
  if [[ -x "$ROOT/post-up-hook" ]]; then
    "$ROOT/post-up-hook" "$id" "$@"
  fi
}

emit_failure_output(){
  local id="$1" phase="$2"
  local stdout_file="$ROOT/stacks/$id/${phase}_stdout"
  local stderr_file="$ROOT/stacks/$id/${phase}_stderr"
  [[ -f "$stdout_file" ]] && cat "$stdout_file"
  [[ -f "$stderr_file" ]] && cat "$stderr_file" >&2
}

compose_cmd(){
  local file="" project_directory="" id cmd
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project-directory)
        project_directory="${2:-}"
        shift 2
        ;;
      -f)
        file="${2:-}"
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done
  cmd="${1:-}"
  shift || true
  id="$(stack_id)"
  if [[ -n "$project_directory" ]]; then
    log_call "compose --project-directory $project_directory -f $file $cmd $*"
  else
    log_call "compose -f $file $cmd $*"
  fi

  case "$cmd" in
    version)
      printf 'Docker Compose version v2.30.0\n'
      ;;
    config)
      if [[ -f "$ROOT/stacks/$id/config_fail" ]]; then
        emit_failure_output "$id" config
        return 16
      fi
      case "${1:-}" in
        --format)
          if [[ "${2:-}" == "json" ]]; then
            if [[ -f "$ROOT/stacks/$id/config_json_fail" ]]; then
              emit_failure_output "$id" config_json
              return 16
            fi
            compose_config_json_from_file "$file" "$project_directory"
          else
            return 1
          fi
          ;;
        --images)
          if [[ -n "${2:-}" ]]; then
            service_images "$id" "$2" "$file"
          else
            service_images "$id" "" "$file"
          fi
          ;;
        --services)
          if [[ -f "$ROOT/stacks/$id/config_services_fail" ]]; then
            emit_failure_output "$id" config_services
            return 16
          fi
          if compose_services_from_file "$file"; then
            :
          elif [[ -f "$ROOT/stacks/$id/services.txt" ]]; then
            cat "$ROOT/stacks/$id/services.txt"
          elif [[ -f "$ROOT/stacks/$id/service-images.tsv" ]]; then
            awk 'BEGIN{FS="\t"} {print $1}' "$ROOT/stacks/$id/service-images.tsv" | sort -u
          else
            return 1
          fi
          ;;
        "")
          [[ -f "$file" ]] && cat "$file"
          ;;
        *)
          return 1
          ;;
      esac
      ;;
    pull)
      if [[ -f "$ROOT/stacks/$id/pull_fail" ]]; then
        emit_failure_output "$id" pull
        return 17
      fi
      apply_pull_state "$id" "$file" "$@"
      run_post_pull_hook "$id" "$@"
      return 0
      ;;
    stop)
      if [[ -f "$ROOT/stacks/$id/stop_fail" ]]; then
        emit_failure_output "$id" stop
        return 18
      fi
      return 0
      ;;
    down)
      if [[ -f "$ROOT/stacks/$id/down_fail" ]]; then
        emit_failure_output "$id" down
        return 18
      fi
      return 0
      ;;
    up)
      if [[ "${1:-}" == "--help" ]]; then
        if [[ "${FAKE_COMPOSE_UP_WAIT:-0}" == "1" ]]; then
          printf 'Usage: docker compose up [OPTIONS]\n      --wait\n      --wait-timeout int\n'
        else
          printf 'Usage: docker compose up [OPTIONS]\n'
        fi
        return 0
      fi
      local up_arg no_start=0
      for up_arg in "$@"; do
        if [[ "$up_arg" == "--no-start" ]]; then
          no_start=1
        fi
      done
      if [[ -f "$ROOT/stacks/$id/up_fail" ||
            "$no_start" -eq 1 && -f "$ROOT/stacks/$id/up_no_start_fail" ]]; then
        emit_failure_output "$id" up
        return 19
      fi
      if [[ "$no_start" -eq 1 ]]; then
        return 0
      fi
      run_post_up_hook "$id" "$file" "$@"
      return 0
      ;;
    pause)
      if [[ -f "$ROOT/stacks/$id/pause_fail" ]]; then
        emit_failure_output "$id" pause
        return 20
      fi
      return 0
      ;;
    unpause)
      if [[ -f "$ROOT/stacks/$id/unpause_fail" ]]; then
        emit_failure_output "$id" unpause
        return 21
      fi
      return 0
      ;;
    ps)
      if [[ -f "$ROOT/stacks/$id/ps_fail" ]]; then
        emit_failure_output "$id" ps
        return 22
      fi
      if [[ "${1:-}" == "-q" ]]; then
        shift
        if (($#)); then
          local service
          for service in "$@"; do
            service_cids "$id" "$service"
          done
        else
          service_cids "$id"
        fi
      else
        return 1
      fi
      ;;
    *)
      return 1
      ;;
  esac
}

inspect_cmd(){
  local format="" target
  if [[ "${1:-}" == "-f" || "${1:-}" == "--format" ]]; then
    format="${2:-}"
    shift 2
  fi
  target="${1:-}"
  log_call "inspect $target"

  if [[ "$format" == *'.Config.Labels'* ]]; then
    local labels_file="$ROOT/containers/$target.labels"
    if [[ -f "$labels_file" ]]; then
      if [[ "$format" =~ index[[:space:]]+\.Config\.Labels[[:space:]]+\"([^\"]+)\" ]]; then
        awk -F= -v label="${BASH_REMATCH[1]}" '$1 == label {print $2}' "$labels_file"
      else
        awk -F= '$1 == "WUD-UPDATER-RECREATE-STACK" {print $2}' "$labels_file"
      fi
    fi
    return 0
  fi

  if [[ "$format" == *'.Image'* ]]; then
    local image_file="$ROOT/containers/$target.image-id"
    [[ -f "$image_file" ]] && cat "$image_file"
    return 0
  fi

  if [[ "$format" == *'.State.Health.Log'* ]]; then
    [[ -f "$ROOT/containers/$target.healthlog" ]] && cat "$ROOT/containers/$target.healthlog"
    return 0
  fi

  if [[ -f "$ROOT/containers/$target.summary" ]]; then
    cat "$ROOT/containers/$target.summary"
    return 0
  fi

  return 1
}

image_cmd(){
  local subcmd="${1:-}"
  shift || true
  [[ "$subcmd" == "inspect" ]] || return 1

  local format="" image
  if [[ "${1:-}" == "--format" ]]; then
    format="${2:-}"
    shift 2
  fi
  image="${1:-}"
  log_call "image inspect $image"

  if [[ "$format" == *'.Id'* ]]; then
    image_id "$image"
  elif [[ "$format" == *'RepoDigests'* ]]; then
    image_digests "$image"
  elif [[ "$format" =~ index[[:space:]]+\.Config\.Labels[[:space:]]+\"([^\"]+)\" ]]; then
    image_label "$image" "${BASH_REMATCH[1]}"
  else
    return 1
  fi
}

manifest_cmd(){
  local subcmd="${1:-}" verbose=0 image file
  [[ "$subcmd" == "inspect" ]] || return 1
  shift || true
  if [[ "${1:-}" == "--verbose" ]]; then
    verbose=1
    shift
  fi
  image="${1:-}"
  if [[ "$verbose" -eq 1 ]]; then
    log_call "manifest inspect --verbose $image"
  else
    log_call "manifest inspect $image"
  fi
  file="$(manifest_file "$image" fail)"
  if [[ -f "$file" ]]; then
    file="$(manifest_file "$image" stderr)"
    [[ -f "$file" ]] && cat "$file" >&2
    return 19
  fi
  if [[ "$verbose" -eq 1 ]]; then
    file="$(manifest_file "$image" verbose_stdout)"
    if [[ -f "$file" ]]; then
      cat "$file"
      return 0
    fi
  fi
  file="$(manifest_file "$image" stdout)"
  if [[ -f "$file" ]]; then
    cat "$file"
  else
    printf '{}\n'
  fi
}

ps_cmd(){
  log_call "ps $*"
  if [[ -f "$ROOT/ps_fail" ]]; then
    printf 'fake docker ps failed\n' >&2
    return 24
  fi
  local include_all=0
  if [[ "${1:-}" == "--all" ]]; then
    include_all=1
    shift
  fi
  if [[ "${1:-}" == "--format" ]]; then
    local format="${2:-}" runtime_file=""
    if [[ "$include_all" -eq 1 && "$format" == *'{{.State}}'* && -f "$ROOT/ps_hang" ]]; then
      kill -STOP "$$"
    fi
    if [[ "$format" == *'com.docker.compose.project.working_dir'* && "$format" == *'com.docker.compose.project.config_files'* && "$format" == *'com.docker.compose.service'* ]]; then
      if [[ "$include_all" -eq 1 && -f "$ROOT/compose-runtime-all.tsv" ]]; then
        runtime_file="$ROOT/compose-runtime-all.tsv"
      else
        runtime_file="$ROOT/compose-runtime.tsv"
      fi
      if [[ -f "$runtime_file" && "$format" == *'{{.State}}'* ]]; then
        awk 'BEGIN {FS=OFS="\t"} NF == 5 {print $0, "running"; next} {print}' "$runtime_file"
      elif [[ -f "$runtime_file" ]]; then
        cat "$runtime_file"
      fi
    else
      [[ -f "$ROOT/containers.tsv" ]] && cat "$ROOT/containers.tsv"
    fi
  elif [[ $# -eq 0 ]]; then
    printf 'CONTAINER ID   IMAGE\n'
  else
    return 1
  fi
}

restart_cmd(){
  local timeout="" container=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --time|-t)
        timeout="${2:-}"
        shift 2
        ;;
      *)
        container="$1"
        shift
        ;;
    esac
  done
  if [[ -n "$timeout" ]]; then
    log_call "restart --time $timeout $container"
  else
    log_call "restart $container"
  fi
  if [[ -f "$ROOT/restart_fail" ]]; then
    cat "$ROOT/restart_fail" >&2
    return 22
  fi
  printf '%s\n' "$container"
}

pull_cmd(){
  local image="${1:-}"
  log_call "pull $image"
  if [[ -f "$ROOT/pull_fail" ]]; then
    cat "$ROOT/pull_fail" >&2
    return 23
  fi
  apply_image_after_pull "$image"
  printf '%s\n' "$image"
}

main(){
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    --version) printf 'Docker version 28.0.0\n' ;;
    version) printf 'Server: Docker Engine 28.0.0\n' ;;
    info) printf 'Docker Root Dir: /var/lib/docker\n' ;;
    compose) compose_cmd "$@" ;;
    image) image_cmd "$@" ;;
    manifest) manifest_cmd "$@" ;;
    inspect) inspect_cmd "$@" ;;
    ps) ps_cmd "$@" ;;
    pull) pull_cmd "$@" ;;
    restart) restart_cmd "$@" ;;
    *) return 1 ;;
  esac
}

main "$@"
