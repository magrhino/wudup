{
  "name": "wudup-webui",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:vite": "vite --host 127.0.0.1 --port 5173",
    "dev:demo": "vite --host 127.0.0.1 --port 5173 --mode demo",
    "build": "vue-tsc --noEmit && vite build",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo",
    "assert:demo-dist": "node scripts/assert-demo-dist.mjs",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "playwright:install": "playwright install chromium",
    "test:smoke": "playwright test",
    "test:smoke:demo": "npm run build:demo && npm run assert:demo-dist && PLAYWRIGHT_WEBUI_DEMO=true PLAYWRIGHT_WEBUI_DEMO_BASE_PATH=/wudup PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173 PLAYWRIGHT_WEB_SERVER_COMMAND=\"npm run preview:demo\" playwright test tests/smoke/webui-demo.spec.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.34.0",
    "@vueuse/core": "^14.4.0",
    "naive-ui": "^2.45.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "postcss-custom-media": "^12.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.11"
  }
}
