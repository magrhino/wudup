# WUDup WebUI Compose environment example.
# Save this as .env next to docker-compose.yml and keep it private (mode 0600).
# Compose fills ${VAR} references from it, and the wudup service loads it with
# env_file. Every variable is described in docs/CONFIGURATION.md.

# Host directory that contains your Compose stacks. WUDup mounts it at the
# same absolute path. See docs/CONFIGURATION.md#first-run-compose-settings.
HOST_DOCKER_BASE=/srv/docker

# WUD 9 administrator, created on WUD's first start. This is separate from the
# WUDup WebUI login. Set a strong generated password.
WUD_AUTH_ADMIN_USER=admin
WUD_AUTH_ADMIN_PASSWORD=

# WUDup's credentials for WUD's API; WUD 9 requires them. Put only the WUD
# password in a host file, add its read-only mount to the wudup service, then
# uncomment these lines. See docs/wiki/webui-container.md#wud-api-authentication;
# docs/CONFIGURATION.md#secrets lists the bearer-token and header alternatives.
# WUD_API_AUTH_BASIC_USER=admin
# WUD_API_AUTH_BASIC_PASSWORD_FILE=/run/secrets/wud_api_password

# Optional: LAN or reverse-proxy exposure. Keep loopback for first run.
# See docs/CONFIGURATION.md#exposure-and-mutation-policy.
# WEBUI_HTTP_BIND=127.0.0.1
# WUD_WEB_PUBLIC_ORIGIN=https://wud.example.test
# WUD_WEB_TRUSTED_PROXIES=127.0.0.1/32

# The WebUI starts read-only. Set true only when you are ready to apply updates
# from the browser.
WUD_WEB_MUTATIONS_ENABLED=false

# Optional: pin a release tag, or use a -trivy tag for candidate security scans.
# WUDUP_IMAGE=ghcr.io/magrhino/wudup:latest
