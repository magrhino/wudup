# WUDup WebUI Compose environment example.
# Copy this file before editing local values:
#   mkdir -p "$HOME/.config/wudup"
#   test -f "$HOME/.config/wudup/webui.env" || \
#     cp docs/examples/webui.env.example "$HOME/.config/wudup/webui.env"

# Stack path mounted into the WebUI container.
#
# Host path where your Docker Compose stack directories live. WUDup mounts
# this same absolute path so Docker Compose project lookups match the host.
HOST_DOCKER_BASE=/srv/docker

# WebUI persistence.
#
# Host directory for WebUI logs and SQLite state. Use an absolute path if you
# want a predictable location outside the Compose example directory.
WEBUI_LOG_DIR=./logs

# Browser bind.
#
# Keep browser access local-only for first run. Change WEBUI_HTTP_BIND only when
# you also configure WUD_WEB_PUBLIC_ORIGIN below.
WEBUI_HTTP_BIND=127.0.0.1
WUD_WEB_PORT=7417

# Container runtime defaults.
WUDUP_IMAGE=ghcr.io/magrhino/wudup:latest
WUD_TIMEZONE=UTC
OUT_UID=1000
OUT_GID=1000

# WUD 9 administrator bootstrap (separate from the WUDup WebUI account).
# Set a strong generated password before first start; keep this env file private
# (mode 0600). Existing WUD administrator credentials are updated if supplied.
WUD_AUTH_ADMIN_USER=admin
WUD_AUTH_ADMIN_PASSWORD=

# WUD API discovery.
#
# The Compose examples put WUD and WUDup on a private app network so the
# WebUI can read best-effort WUD metadata without publishing WUD's port.
WUD_API_BASE_URL=http://wud:3000
WUD_API_STARTUP_WAIT_SECONDS=5

# WUD API auth: required by WUD 9, even on the private app network.
# WUD's bootstrap credentials above are not automatically sent by WUDup.
# Choose one method below; see wiki/webui-container.md#wud-api-authentication.
#
# Prefer secret-file inputs for container deployments. WUD_API_HEADERS_FILE must
# contain a JSON object of header names to string values, for example
# {"X-Api-Key":"example"} in a host-local file mounted into the container.
# WUD_API_AUTH_BEARER_TOKEN_FILE=/run/secrets/wud_api_token
# WUD_API_AUTH_BASIC_USER=admin
# WUD_API_AUTH_BASIC_PASSWORD_FILE=/run/secrets/wud_api_password
# Mount this password-only file read-only into WUDup; it is not an env file.
# WUD_API_HEADERS_FILE=/run/secrets/wud_api_headers.json
#
# Configure only one WUD API authentication method at a time. Bearer token
# auth and basic auth are mutually exclusive, and WUD_API_HEADERS_FILE must not
# include an Authorization header when either bearer or basic auth is configured.
#
# Direct token/password values are accepted for local development only.
# WUD_API_AUTH_BEARER_TOKEN=example-token
# WUD_API_AUTH_BASIC_PASSWORD=example-password

# Legacy WUD script mode.
#
# Leave true or unset to keep legacy mounted WUD scripts and images.todo file
# support. Set false after WUD API access is healthy and after removing WUD
# command triggers that call /wud/append-updates.sh, /wud/on-update.sh, or
# /wud/tag-manager.sh, then recreating the stack. FALSE is accepted.
WUDUP_LEGACY_SCRIPTS=true

# WebUI pending source.
#
# api reads WUD /api/containers over the private Compose app network. file
# reads the legacy callback todo file. auto tries api first and falls back to
# WUD_OUT_FILE when WUD is unavailable, auth-required, or returns unusable
# metadata. The host CLI updater remains legacy file-mode only.
WUD_PENDING_SOURCE=api

# Compose discovery.
#
# Optional: comma-separated compose discovery archive paths. Leave unset to
# discover every directory or manage this from Settings after enabling WebUI
# mutations.
# WUD_COMPOSE_IGNORE_PATHS=old,archive/disabled

# Read-only and mutation mode.
#
# The WebUI starts read-only. Set true only when you are ready to run plan/apply
# updates, candidate security scan refresh jobs, and container restart from the
# browser.
WUD_WEB_MUTATIONS_ENABLED=false

# Optional candidate vulnerability advisory prototype.
#
# Disabled by default. For container deployments that refresh scans, set
# WUDUP_IMAGE=ghcr.io/magrhino/wudup:latest-trivy. The WebUI resolves pending
# candidates to immutable manifest digests and runs Trivy registry scans only
# after an authenticated refresh request. When WUD local_digest metadata is
# available, refresh also compares the installed digest with the candidate.
# Refresh requires WUD_WEB_MUTATIONS_ENABLED=true; read-only deployments can
# only display cached scan metadata. Results are advisory metadata only; they do
# not gate, snooze, or mark an image safe.
WUD_SECURITY_SCANNING_ENABLED=false
# Advanced override when trivy is installed at a non-standard path.
# WUD_SECURITY_SCANNER_EXECUTABLE=trivy
# WUD_SECURITY_SCAN_CACHE_DIR=/logs/trivy-cache
# WUD_SECURITY_SCAN_TIMEOUT_SECONDS=300

# Restart target and release metadata.
#
# Optional: override the Docker container name or ID restarted from Settings.
# When unset inside the published container image, the WebUI derives this from
# Docker's HOSTNAME value.
# WUD_WEB_RESTART_CONTAINER=wudup

# Release-note notifications default disabled and can be enabled from Settings.
# When enabled with WebUI mutations, WUDup polls WUD's API by default.
# Uncomment only when you want the environment to force the value and make the
# Settings toggle read-only.
# WUD_RELEASE_NOTES_ENABLED=true

# Optional: higher GitHub release-note metadata rate limits.
# GITHUB_TOKEN=ghp_example

# Optional: Discord destination for WebUI release-note notifications. This
# env value overrides and disables the WebUI-managed webhook field.
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/example

# Optional: LAN or reverse-proxy exposure. Keep WEBUI_HTTP_BIND=127.0.0.1 for a
# reverse proxy running on the same host; bind to a LAN address only when
# exposing the WebUI directly. Add WUD_WEB_ALLOWED_HOSTS only for extra aliases.
# WUD_WEB_PUBLIC_ORIGIN=https://wud.example.test
# WUD_WEB_ALLOWED_HOSTS=updates.example.test,192.168.1.20
# Accepts proxy IPs, CIDRs, or hostnames; hostnames resolve at WebUI startup.
# WUD_WEB_TRUSTED_PROXIES=127.0.0.1/32
# WUD_WEB_SECURE_COOKIES=auto
