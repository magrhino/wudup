{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["dockerfile"],
  "includePaths": ["Dockerfile"],
  "timezone": "America/Chicago",
  "schedule": ["* 9-12 * * 1"],
  "prConcurrentLimit": 3,
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "ignoreUnstable": true,
  "minimumReleaseAge": "7 days",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Mark patch, pin, and digest Docker updates for merge automation",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "addLabels": ["automerge"]
    },
    {
      "description": "Mark minor Docker updates for merge automation, except Python minor releases (e.g. 3.14 -> 3.15), which a maintainer merges",
      "matchUpdateTypes": ["minor"],
      "matchPackageNames": ["!python"],
      "addLabels": ["automerge"]
    },
    {
      "description": "Ship Docker CLI/Compose security fixes sooner; the bundled Go binaries are scanned on every edge and release publish",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker"],
      "minimumReleaseAge": "1 day"
    }
  ],
  "pinDigests": true
}
