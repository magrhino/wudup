{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["dockerfile"],
  "includePaths": ["Dockerfile"],
  "timezone": "America/Chicago",
  "schedule": ["* 9-12 * * 1"],
  "prConcurrentLimit": 3,
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "ignoreUnstable": true,
  "minimumReleaseAge": "7 days",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Mark non-major Docker updates for merge automation",
      "matchDepNames": ["!aquasec/trivy"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "addLabels": ["automerge"]
    },
    {
      "description": "Open Trivy updates for manual review while its patched source build is pinned",
      "matchDepNames": ["aquasec/trivy"],
      "automerge": false,
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"],
      "prBodyNotes": ["Review only: the Trivy binary is built from separately pinned source in Dockerfile. Update its source tag, commit, version metadata, and patched dependencies before merging."]
    }
  ],
  "pinDigests": true
}
