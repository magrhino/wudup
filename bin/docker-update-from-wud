#!/usr/bin/env bash
set -Eeuo pipefail

source_path="${BASH_SOURCE[0]}"
while [[ -L "$source_path" ]]; do
  source_dir="$(cd -P "$(dirname "$source_path")" && pwd -P)"
  link_target="$(readlink "$source_path")"
  if [[ "$link_target" == /* ]]; then
    source_path="$link_target"
  else
    source_path="$source_dir/$link_target"
  fi
done

script_dir="$(cd -P "$(dirname "$source_path")" && pwd -P)"
repo_dir="$(cd "$script_dir/.." && pwd -P)"

python_has_runtime_deps() {
  "$1" - >/dev/null 2>&1 <<'PY'
import sys
if sys.version_info < (3, 11):
    raise SystemExit(1)
import rich
import ruamel.yaml
PY
}

python_bin="${PYTHON_BIN:-python3}"
venv_dir="${WUDUP_VENV:-${WUD_UPDATER_VENV:-$repo_dir/.venv}}"
if [[ -z "${PYTHON_BIN:-}" && -x "$venv_dir/bin/python" ]]; then
  if ! python_has_runtime_deps "$python_bin"; then
    python_bin="$venv_dir/bin/python"
  fi
fi

if [[ -n "${PYTHONPATH:-}" ]]; then
  export PYTHONPATH="${repo_dir}/src:${PYTHONPATH}"
else
  export PYTHONPATH="${repo_dir}/src"
fi

exec "$python_bin" -m wudup.cli update-from-wud "$@"
